=1;html=1;endArrow=block;endFill=1;endSize=7;strokeWidth=1.6;strokeColor=#334155;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;fontFamily=Segoe UI;fontSize=10.5;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="detailed-c3" target="detailed-images"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="detailed-e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=7;strokeWidth=1.6;strokeColor=#334155;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;fontFamily=Segoe UI;fontSize=10.5;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="detailed-c4" target="detailed-curves"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="detailed-e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=7;strokeWidth=1.6;strokeColor=#334155;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;fontFamily=Segoe UI;fontSize=10.5;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="detailed-c5" target="detailed-logs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="detailed-legend" value='&lt;b&gt;Colours:&lt;/b&gt; blue = 1 section export, amber = 2a picture definition (manual steps marked &amp;#9679;), green = 2b image &amp;amp; curve export; cylinder = results database; wavy box = file / folder; dashed = link to the rest of the seismic analysis or optional step.&lt;br&gt;Alternatives to 2a: MODE = "capture" in A_2_Image_export_Auto.py (pictures printed in Abaqus, read from abaqus.rpy), or VIEWS / VARIABLES edited in the script.&lt;br&gt;Order: 1 → 2a → 2b.  2a needs 1 only for the curve lists; 2b needs the settings of 2a and, for the curves, the results database of 1.' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="802" width="1590" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
